{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eian.local/eian-paper-ui-broll/segment.schema.json",
  "title": "eian-paper-ui-broll Segmentation Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "fps", "continuityMode", "sourceDurationInFrames", "minPartFrames", "maxPartFrames", "partCount", "parts"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fps": {"const": 24},
    "continuityMode": {"const": "global-frame-slice"},
    "sourceDurationInFrames": {"type": "integer", "minimum": 1},
    "minPartFrames": {"type": "integer", "const": 72},
    "maxPartFrames": {"type": "integer", "const": 192},
    "targetPartFrames": {"type": "integer", "minimum": 72, "maximum": 192},
    "partCount": {"type": "integer", "minimum": 1},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["part", "globalStartFrame", "globalEndFrameExclusive", "durationInFrames", "durationSeconds", "startsWithCarryOver", "isFinal", "cutReason"],
        "properties": {
          "part": {"type": "integer", "minimum": 1},
          "globalStartFrame": {"type": "integer", "minimum": 0},
          "globalEndFrameExclusive": {"type": "integer", "minimum": 1},
          "durationInFrames": {"type": "integer", "minimum": 72, "maximum": 192},
          "durationSeconds": {"type": "number", "minimum": 3, "maximum": 8},
          "startsWithCarryOver": {"type": "boolean"},
          "isFinal": {"type": "boolean"},
          "cutReason": {"type": "string"},
          "stateAtStart": {
            "type": "object",
            "properties": {
              "visibleMessageIds": {"type": "array", "items": {"type": "string"}},
              "activeTypingMessageId": {"type": ["string", "null"]},
              "activeRevealMessageId": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
